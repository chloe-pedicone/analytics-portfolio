model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DataFolder","dim_agency","dim_borough","dim_complaint_type","dim_date","fact_service_request","_Measure"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_agency
ref table dim_borough
ref table dim_complaint_type
ref table dim_date
ref table fact_service_request
ref table _Measure

ref cultureInfo en-US

