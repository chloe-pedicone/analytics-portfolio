// P2 · NYC 311 service performance - key measures
// fact_service_request[CreatedDate] -> dim_date[Date] (dim_date marked as date table)

Requests = COUNTROWS ( fact_service_request )

Closed Requests = CALCULATE ( [Requests], fact_service_request[IsClosed] = TRUE () )

Median Hours to Close = MEDIAN ( fact_service_request[HoursToClose] )

Avg Hours to Close = AVERAGE ( fact_service_request[HoursToClose] )

Open Requests = CALCULATE ( [Requests], fact_service_request[IsClosed] = FALSE () )

// Open requests already past their SLA (definite misses).
// "As of" = the latest created hour in the data, not today's clock (timestamps are NYC wall-clock).
// Age uses the END of the created hour, so it never overstates age.
Open Past SLA =
VAR _asOf =
    MAXX (
        ALL ( fact_service_request ),
        fact_service_request[CreatedDate] + fact_service_request[CreatedHour] / 24
    )
RETURN
    COUNTROWS (
        FILTER (
            fact_service_request,
            fact_service_request[IsClosed] = FALSE ()
                && ( _asOf - ( fact_service_request[CreatedDate] + ( fact_service_request[CreatedHour] + 1 ) / 24 ) ) * 24
                    > fact_service_request[SlaHours]
        )
    )

// SLA % over CLOSED requests with a valid close time only (WithinSLA is blank otherwise).
// Open requests are excluded here; see [Open Past SLA] for those already missed.
% Closed Within SLA =
DIVIDE (
    CALCULATE ( [Requests], fact_service_request[WithinSLA] = TRUE () ),
    CALCULATE ( [Requests], NOT ISBLANK ( fact_service_request[WithinSLA] ) )
)

% Closed Within SLA PY = CALCULATE ( [% Closed Within SLA], SAMEPERIODLASTYEAR ( dim_date[Date] ) )

% Closed Within SLA YoY pts =
VAR _cur = [% Closed Within SLA]
VAR _py = [% Closed Within SLA PY]
RETURN IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), _cur - _py )

% After Hours =
DIVIDE (
    CALCULATE ( [Requests], fact_service_request[HourCategory] = "OutOfBusiness" ),
    [Requests]
)

// Business-day-aware daily average (same logic as CS1).
Avg Requests per Day =
VAR _first = CALCULATE ( MIN ( fact_service_request[CreatedDate] ), REMOVEFILTERS ( fact_service_request[HourCategory] ) )
VAR _last  = CALCULATE ( MAX ( fact_service_request[CreatedDate] ), REMOVEFILTERS ( fact_service_request[HourCategory] ) )
VAR _businessOnly = SELECTEDVALUE ( fact_service_request[HourCategory] ) = "Business"
VAR _days =
    IF (
        _businessOnly,
        CALCULATE ( COUNTROWS ( dim_date ), DATESBETWEEN ( dim_date[Date], _first, _last ), dim_date[IsBusinessDay] = TRUE () ),
        CALCULATE ( COUNTROWS ( dim_date ), DATESBETWEEN ( dim_date[Date], _first, _last ) )
    )
RETURN DIVIDE ( [Requests], _days )

// Field parameters (Modeling > New parameter > Fields)
Metric Selector = {
    ( "Requests",              NAMEOF ( [Requests] ),              0 ),
    ( "% Closed Within SLA",   NAMEOF ( [% Closed Within SLA] ),   1 ),
    ( "Median Hours to Close", NAMEOF ( [Median Hours to Close] ), 2 ),
    ( "Avg Requests per Day",  NAMEOF ( [Avg Requests per Day] ),  3 ),
    ( "% After Hours",         NAMEOF ( [% After Hours] ),         4 )
}

Date Grain = {
    ( "Week",    NAMEOF ( 'dim_date'[WeekStart] ),   0 ),
    ( "Month",   NAMEOF ( 'dim_date'[MonthStart] ),  1 ),
    ( "Quarter", NAMEOF ( 'dim_date'[YearQuarter] ), 2 ),
    ( "Year",    NAMEOF ( 'dim_date'[Year] ),        3 )
}
