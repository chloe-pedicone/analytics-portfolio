// P1 · CMS readmissions - key measures
// Model: FactReadmission (*)-(1) DimHospital[FacilityID], DimMeasure[MeasureKey];
//        FactReadmission[FiscalYear] (*)-(1) DimFiscalYear[FiscalYear]

Hospitals = DISTINCTCOUNT ( FactReadmission[FacilityID] )

Avg Excess Readmission Ratio = AVERAGE ( FactReadmission[ExcessReadmissionRatio] )

// Weight by discharges so a 25-discharge hospital doesn't count as much as a 900-discharge one.
// Numerator and denominator use the SAME rows (both values present).
Weighted Excess Ratio =
VAR _rows =
    FILTER (
        FactReadmission,
        NOT ISBLANK ( FactReadmission[ExcessReadmissionRatio] )
            && NOT ISBLANK ( FactReadmission[Discharges] )
    )
RETURN
    DIVIDE (
        SUMX ( _rows, FactReadmission[ExcessReadmissionRatio] * FactReadmission[Discharges] ),
        SUMX ( _rows, FactReadmission[Discharges] )
    )

% Measures Worse Than Expected =
DIVIDE (
    CALCULATE ( COUNTROWS ( FactReadmission ), FactReadmission[IsWorseThanExpected] = TRUE () ),
    CALCULATE ( COUNTROWS ( FactReadmission ), NOT ISBLANK ( FactReadmission[IsWorseThanExpected] ) )
)

// VALUES(State) is evaluated BEFORE REMOVEFILTERS, so a hospital row keeps its own state.
// (ALLEXCEPT(DimHospital, DimHospital[State]) would return the NATIONAL average on a
//  hospital-level visual, because the filter there is on FacilityID, not State.)
Excess Ratio - State Avg =
CALCULATE (
    [Avg Excess Readmission Ratio],
    REMOVEFILTERS ( DimHospital ),
    VALUES ( DimHospital[State] )
)

Excess Ratio - National Avg =
CALCULATE ( [Avg Excess Readmission Ratio], REMOVEFILTERS ( DimHospital ) )

// Rank within the hospital's own state, 1 = lowest (best) ratio. Blank hospitals are not ranked.
Rank in State =
VAR _me = [Avg Excess Readmission Ratio]
VAR _state = SELECTEDVALUE ( DimHospital[State] )
RETURN
    IF (
        HASONEVALUE ( DimHospital[FacilityID] ) && NOT ISBLANK ( _me ),
        CALCULATE (
            VAR _peers =
                FILTER ( VALUES ( DimHospital[FacilityID] ), NOT ISBLANK ( [Avg Excess Readmission Ratio] ) )
            RETURN
                COUNTROWS ( FILTER ( _peers, [Avg Excess Readmission Ratio] < _me ) ) + 1,
            REMOVEFILTERS ( DimHospital ),
            DimHospital[State] = _state
        )
    )

// Share of hospitals nationally with a LOWER ratio (0% = best in the nation).
National Percentile =
VAR _me = [Avg Excess Readmission Ratio]
RETURN
    IF (
        HASONEVALUE ( DimHospital[FacilityID] ) && NOT ISBLANK ( _me ),
        CALCULATE (
            VAR _peers =
                FILTER ( VALUES ( DimHospital[FacilityID] ), NOT ISBLANK ( [Avg Excess Readmission Ratio] ) )
            RETURN
                DIVIDE ( COUNTROWS ( FILTER ( _peers, [Avg Excess Readmission Ratio] < _me ) ), COUNTROWS ( _peers ) ),
            REMOVEFILTERS ( DimHospital )
        )
    )

// Year-over-year change for the selected fiscal year (DimFiscalYear is a plain integer table).
Excess Ratio vs Prior FY =
VAR _fy = SELECTEDVALUE ( DimFiscalYear[FiscalYear] )
VAR _cur = [Avg Excess Readmission Ratio]
VAR _prior = CALCULATE ( [Avg Excess Readmission Ratio], DimFiscalYear[FiscalYear] = _fy - 1 )
RETURN
    IF ( NOT ISBLANK ( _fy ) && NOT ISBLANK ( _cur ) && NOT ISBLANK ( _prior ), _cur - _prior )
